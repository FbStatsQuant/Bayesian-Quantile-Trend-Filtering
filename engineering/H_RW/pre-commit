#!/usr/bin/env python3
"""H-RW candidate hook. Check the staged path and blob, regardless of unstaged edits."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from audit import MIB, SECRET_MARKER, blobs, git, hits, removal_rules, rules, safe


def main():
    repo = Path(git("rev-parse", "--show-toplevel").decode().rstrip("\n"))
    stage = git("ls-files", "-z", "--stage", repo=repo).split(b"\0")
    paths = {}
    for record in stage:
        if record:
            metadata, filename = record.split(b"\t", 1)
            mode, oid, slot = metadata.split()
            if slot == b"0":
                paths[filename] = (mode, oid)
    staged = git("diff", "--cached", "--name-only", "-z", "--no-renames",
                 "--diff-filter=ACMRT", repo=repo).split(b"\0")
    patterns = rules()
    forbidden_paths = removal_rules()
    allow_file = paths.get(b".githooks/size_allowlist.txt")
    rejected = False
    with blobs(repo) as get:
        size_allow = set()
        if allow_file:
            size_allow = {line for line in get(allow_file[1]).splitlines()
                          if line.strip() and not line.lstrip().startswith(b"#")}
        for filename in filter(None, staged):
            mode, oid = paths[filename]
            problems = []
            if any(rule.search(filename) for rule in forbidden_paths):
                problems.append("purged path")
            if hits(filename, patterns):
                problems.append("private pattern in filename")
            if mode != b"160000":
                size = int(git("cat-file", "-s", oid.decode(), repo=repo))
                if size > 5 * MIB and filename not in size_allow:
                    problems.append(f"{size} bytes exceeds 5 MiB")
                else:
                    body = get(oid)
                    if hits(body, patterns):
                        problems.append("private pattern in blob")
                    if SECRET_MARKER.search(body):
                        problems.append("credential marker in blob")
            if problems:
                rejected = True
                print(f"pre-commit refused {safe(filename, patterns)} ({', '.join(problems)})",
                      file=sys.stderr)
    return int(rejected)


if __name__ == "__main__":
    sys.exit(main())
