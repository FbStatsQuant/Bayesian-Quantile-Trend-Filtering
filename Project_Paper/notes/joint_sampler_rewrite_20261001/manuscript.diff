 \subsection{Joint Quantile Sampler}
 \label{subsec:joint}
 
-% Content removed on 2026-09-26; this subsection will be rewritten for Bayesian-PMALA (Section~\ref{subsec:individual}).
+Let $0 < \tau_1 < \cdots < \tau_J < 1$ be the quantile levels of interest, and write $\theta_j$, $z_j$, $\lambda_j$ and $\sigma_j$ for the trend, latent variables, regularization parameter and likelihood scale at level $\tau_j$. Each level uses the individual specification of Section~\ref{subsec:individual}, including the unscaled difference prior \eqref{eq:prior_theta} and the hyperpriors \eqref{eq:hyperpriors}. The levels are coupled by the requirement that their trends be ordered at every observed index,
+\begin{equation}
+    \mathcal C = \left\{(\theta_1,\ldots,\theta_J):
+    \theta_{i1} \leq \cdots \leq \theta_{iJ},\quad i=1,\ldots,n\right\}.
+    \label{eq:joint_order}
+\end{equation}
+This constraint concerns the observation grid; it does not by itself specify an ordering-preserving interpolation between observations.
+
+\paragraph{Joint target.} Let $\pi_j(\theta_j,z_j,\lambda_j,\sigma_j\mid\by)$ denote the augmented posterior factor in \eqref{eq:posterior}, with $\tau=\tau_j$. We define the joint working posterior by
+\begin{equation}
+    \pi_{\mathcal C}(\Theta,Z,\blambda,\bm\sigma\mid\by)
+    \propto \mathbbm{1}_{\mathcal C}(\Theta)
+    \prod_{j=1}^J \pi_j(\theta_j,z_j,\lambda_j,\sigma_j\mid\by),
+    \label{eq:joint_target}
+\end{equation}
+where $\Theta=(\theta_1,\ldots,\theta_J)$ and $Z=(z_1,\ldots,z_J)$. This is a globally constrained product of working posterior factors for the same data, not a claim that the data are independently observed at each quantile level. In particular, the factors are not replaced by separately normalized truncated priors: a normalizing constant that depended on $\lambda_j$ would change its conditional distribution. Under \eqref{eq:joint_target}, the order indicator depends only on $\Theta$. Thus, conditional on the trends, the updates for $z_j$, $\lambda_j$ and $\sigma_j$ remain \eqref{eq:zupdate}--\eqref{eq:sigmaupdate}, with the appropriate quantile index. There is one $\lambda_j$ and one $\sigma_j$ per level, and no additional penalty parameter coupling the levels.
+
+\paragraph{Sequential conditional bounds.} A sweep visits $j=1,\ldots,J$ in increasing order and completes all updates for level $j$ before proceeding to $j+1$. At sweep $t$, its lower and upper bounds are
+\begin{equation}
+\begin{aligned}
+    \ell_j &= \begin{cases}\theta_{j-1}^{(t)}, & j>1,\\ -\infty\mathbf 1, & j=1,\end{cases}
+    & u_j &= \begin{cases}\theta_{j+1}^{(t-1)}, & j<J,\\ +\infty\mathbf 1, & j=J,\end{cases} \\
+    B_j &= \{\vartheta\in\R^n:\ell_j\leq\vartheta\leq u_j\}.
+\end{aligned}
+    \label{eq:joint_box}
+\end{equation}
+All inequalities are componentwise. The lower neighbor already includes its trend and interweaving updates from the current sweep. The upper neighbor has not yet been visited. These bounds are held fixed throughout the trend and interweaving updates for level $j$; using them preserves \eqref{eq:joint_order} after each accepted move, rather than only at the end of a sweep.
+
+\paragraph{Bounded proximal proposal and Metropolis correction.} With $w_{ij}$ and $r_{ij}$ defined by \eqref{eq:weights} at level $\tau_j$, set
+\begin{equation}
+\begin{aligned}
+    U_j(\vartheta) &= \frac12\sum_{i=1}^n w_{ij}(\vartheta_i-r_{ij})^2
+                    +\lambda_j\norm{D\vartheta}_1,\\
+    T_j(x) &= \arg\min_{\vartheta\in B_j}
+             \left\{U_j(\vartheta)+\frac{1}{2\gamma_j}\norm{\vartheta-x}_{M_j}^2\right\},
+             \qquad \gamma_j=\delta_j/2.
+\end{aligned}
+    \label{eq:joint_prox}
+\end{equation}
+The metric is $M_j=W_j+c_jD^\top D$, where $W_j=\mathrm{diag}(w_{1j},\ldots,w_{nj})$ and the implemented curvature coefficient is $c_j=\min(\kappa\lambda_j^2/2,10^8)$, with $\kappa=3$. It is fixed during this conditional trend update. The bounded optimization includes the Gaussian likelihood term and the difference penalty together. ADMM approximates \eqref{eq:joint_prox} by splitting both the differences and the box constraint; it is not an unconstrained optimization followed by clipping its solution. Denote the resulting deterministic, finite-iteration map by $\widehat T_j$ (Appendix~\ref{app:pmala:joint}).
+
+From the current trend $\theta_j$, draw the ordinary Gaussian proposal
+\begin{equation}
+    \theta_j^\star\sim q_j(\,\cdot\mid\theta_j)
+    =\mathcal N\!\left(\widehat T_j(\theta_j),\delta_jM_j^{-1}\right).
+    \label{eq:joint_proposal}
+\end{equation}
+If $\theta_j^\star\notin B_j$, reject it because its conditional target density is zero. The Gaussian draw is neither projected into the box nor repeatedly drawn until feasible. For an in-box proposal, compute $\widehat T_j(\theta_j^\star)$ with the same neighbors, metric, step size and solver rule, and accept with probability $\min(1,\alpha_j)$, where
+\begin{equation}
+\begin{aligned}
+    \log\alpha_j ={}& U_j(\theta_j)-U_j(\theta_j^\star)\\
+    &+\frac{\norm{\theta_j^\star-\widehat T_j(\theta_j)}_{M_j}^2
+            -\norm{\theta_j-\widehat T_j(\theta_j^\star)}_{M_j}^2}{2\delta_j}.
+\end{aligned}
+    \label{eq:joint_accept}
+\end{equation}
+The two Gaussian normalizing constants cancel because their covariance matrices coincide. There is no truncated-Gaussian normalizer. Given the other blocks, this is a valid Metropolis--Hastings update for $e^{-U_j(\theta_j)}\mathbbm{1}_{B_j}(\theta_j)$ even when $\widehat T_j\ne T_j$: the computed map defines the proposal mean in both directions. This conditional invariance statement does not assert exact optimization, convergence of a finite chain, or exactness of numerical safeguards in the other blocks.
+
+\paragraph{Constrained interweaving.} After updating $z_j$ and drawing $\lambda_j$ from \eqref{eq:lambdaupdate}, we apply the interweaving construction of Appendix~\ref{app:pmala:asis}, retaining the same box $B_j$. Write $p_j=QQ^\top\theta_j$ and $v_j=\theta_j-p_j$, with $Q$ an orthonormal basis of the null space of $D$. Holding $p_j$ and $\lambda_jD\theta_j$ fixed, a new $\lambda_j'>0$ implies
+\begin{equation}
+    \theta_j(\lambda_j')=p_j+(\lambda_j/\lambda_j')v_j.
+    \label{eq:joint_asis_curve}
+\end{equation}
+We slice sample $\eta=\log\lambda_j'$ from the ancillary conditional restricted to $\theta_j(e^\eta)\in B_j$. Both $\lambda_j$ and $\theta_j$ are then replaced together. An unconstrained redraw could undo the ordering enforced by the trend move, so the restriction is essential. Appendix~\ref{app:pmala:joint} derives the feasible interval and its log density. The subsequent update of $\sigma_j$ uses this updated trend and the current $z_j$; the unscaled prior contributes no $\lambda_j\norm{D\theta_j}_1$ term to its rate.
+
+\paragraph{Unified sweep and its scope.} Algorithm~\ref{alg:joint_pmala} summarizes the update. The current unified implementation uses $200$ ADMM iterations per map, including the discarded optimization warm-up. It adapts a separate $\delta_j$ only after warm-up and through the last burn-in sweep, then freezes it. These settings apply also when $J=1$ and differ from the earlier individual simulation settings described in Appendix~\ref{app:pmala:admm}--\ref{app:pmala:adapt}; those earlier experiments are not rerun by defining the joint extension. Initialization, adaptation and the distinction between the mathematical kernels and the retained numerical guards are detailed in Appendix~\ref{app:pmala:joint}.
+
+For $J=1$, $B_1=\R^n$ and \eqref{eq:joint_target} reduces to \eqref{eq:posterior}. The implementation dispatches the unbounded proximal, Metropolis and interweaving updates to the guarded individual routines without extra random draws. A matched-seed check at $\tau=0.10$ reproduced the complete individual trajectories and final random-number-generator state. Short joint checks at central and upper-tail levels preserved ordering, but exhibited poor mixing, especially at $\tau=0.99$. They establish implementation agreement and support preservation in the tested cases, not convergence or reliable tail inference. Extra quantile levels, if supplied, enter \eqref{eq:joint_target} as full factors and change the target; the algorithm does not automatically add sentinel levels or prescribe their placement.
+
+\begin{algorithm}[!htbp]
+\caption{Unified Bayesian-PMALA for ordered quantile levels}
+\label{alg:joint_pmala}
+\begin{algorithmic}[1]
+\Require Data $\by$, ordered levels $\tau_1,\ldots,\tau_J$, sweeps $T$, burn-in $B$, warm-up $H\leq B$, trend moves $K$ (default $1$).
+\State Initialize ordered trends and each $(z_j,\lambda_j,\sigma_j,\delta_j)$ as in Appendix~\ref{app:pmala:joint}
+\For{$t=1,\ldots,T$}
+    \For{$j=1,\ldots,J$}
+        \State Fix $B_j$ using the latest neighbors in \eqref{eq:joint_box}
+        \If{$t\leq H$}
+            \State Apply the bounded optimization warm-up to $\theta_j$
+        \Else
+            \State Apply $K$ moves \eqref{eq:joint_proposal}--\eqref{eq:joint_accept} at fixed $(z_j,\lambda_j,\sigma_j,\delta_j,B_j)$
+        \EndIf
+        \State Update $z_j$ by \eqref{eq:zupdate}; draw $\lambda_j$ by \eqref{eq:lambdaupdate}
+        \If{$t>H$}
+            \State Redraw $(\lambda_j,\theta_j)$ by constrained interweaving in $B_j$
+        \EndIf
+        \State Draw $\sigma_j$ by \eqref{eq:sigmaupdate} using the updated $\theta_j$
+        \If{$H<t\leq B$}
+            \State Adapt $\delta_j$ using the mean acceptance probability of its $K$ trend moves
+        \EndIf
+    \EndFor
+    \State Retain the completed sweep only if $t>B$
+\EndFor
+\end{algorithmic}
+\end{algorithm}
